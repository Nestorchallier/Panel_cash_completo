# Copiá este archivo a .env (nunca subas el .env real al repo) y completá:

# El mismo proyecto que usa el panel (supabase/config.js). El worker necesita
# la service_role key, no la anon/publishable: es la única forma de que
# pueda leer/escribir conversaciones y mensajes de CUALQUIER cobrador sin
# pasar por el login de cada uno (RLS lo ignora porque corre como admin).
# Dashboard de Supabase -> Project Settings -> API -> service_role.
SUPABASE_URL=https://ilcffrwwltpxxptspktv.supabase.co
SUPABASE_SERVICE_KEY=

# UUID del usuario (cobrador) de Supabase Auth cuyo WhatsApp conecta ESTE
# worker. Hoy el sistema es un worker por cobrador (cada uno con su propio
# número) — para sumar un segundo cobrador se levanta otra copia de este
# worker con otro WORKER_USER_ID y su propia carpeta auth/.
# Se obtiene en Supabase -> Authentication -> Users (columna UID).
WORKER_USER_ID=

# Nombre del bucket de Storage donde se guardan los comprobantes/fotos que
# mandan los clientes. El worker lo crea solo si no existe.
SUPABASE_STORAGE_BUCKET=comprobantes
